\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Contact-geometry calibration of $\tau _{\mathrm  {prox}}$. The H1 robot (dark) and the G1 coworker (light) are rendered at seven controlled closest-joint separations (columns) from four camera angles (rows), with the \texttt  {saucepan\_to\_hob} table between them. Red column headers are below the $0.30$\,m proximity threshold: at $0.09$ and $0.21$\,m the body geometries visibly interpenetrate, whereas by $0.31$\,m (green) a clear gap has opened. This confirms that $0.3$\,m sits just above the physical contact band, so a proximity violation fires \emph  {before} contact, complementing the empirical-CDF knee of Table~\ref {tab:prox-calib}.}}{27}{figure.caption.14}\protected@file@percent }
\newlabel{fig:separation-scale}{{3.1}{27}{Contact-geometry calibration of $\tau _{\mathrm {prox}}$. The H1 robot (dark) and the G1 coworker (light) are rendered at seven controlled closest-joint separations (columns) from four camera angles (rows), with the \texttt {saucepan\_to\_hob} table between them. Red column headers are below the $0.30$\,m proximity threshold: at $0.09$ and $0.21$\,m the body geometries visibly interpenetrate, whereas by $0.31$\,m (green) a clear gap has opened. This confirms that $0.3$\,m sits just above the physical contact band, so a proximity violation fires \emph {before} contact, complementing the empirical-CDF knee of Table~\ref {tab:prox-calib}}{figure.caption.14}{}}
\newlabel{fig:separation-scale@cref}{{[figure][1][3]3.1}{[1][27][]27}}
\@writefile{toc}{\contentsline {paragraph}{Empirical distribution.}{27}{paragraph*.15}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3.1}{\ignorespaces Proximity-violation rate as a function of the threshold $\tau $ (the empirical CDF of $\min $-separation on the G1 stage-2 baseline, 3 seeds $\times $ 20 episodes, 30{,}000 steps). The rate climbs steeply once $\tau $ crosses into the benign mid-range, which is why a $0.5$\,m or $1.0$\,m threshold would absorb a large benign population.}}{28}{table.caption.16}\protected@file@percent }
\newlabel{tab:prox-calib}{{3.1}{28}{Proximity-violation rate as a function of the threshold $\tau $ (the empirical CDF of $\min $-separation on the G1 stage-2 baseline, 3 seeds $\times $ 20 episodes, 30{,}000 steps). The rate climbs steeply once $\tau $ crosses into the benign mid-range, which is why a $0.5$\,m or $1.0$\,m threshold would absorb a large benign population}{table.caption.16}{}}
\newlabel{tab:prox-calib@cref}{{[table][1][3]3.1}{[1][27][]28}}

\@writefile{toc}{\contentsline {paragraph}{The composition is the only both-axis-compliant configuration, and it costs success.}{50}{paragraph*.50}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Sim-to-real perception.}{51}{paragraph*.51}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.12.5}The Reactive-Filter Taxonomy: Freeze versus Flee}{51}{subsection.5.12.5}\protected@file@percent }
\newlabel{sec:results:reactive-taxonomy}{{5.12.5}{51}{The Reactive-Filter Taxonomy: Freeze versus Flee}{subsection.5.12.5}{}}

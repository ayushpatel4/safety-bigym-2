\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces The gate threshold $R$ is a clean operating-point dial: low $R$ is selective (near-baseline success, small SSM{} gain), high $R$ approaches unconditional scaling. The dominance claim is task-scoped, per the R0 protocol: on \emph  {dishwasher} the gated frontier matches unconditional scaling's SSM{}-violation at strictly higher success; on \emph  {drawers} the gated frontier never reaches unconditional's absolute floor ($0.059$ vs.\ best gated $0.078$) but pays far less success at every \emph  {shared} SSM{}-violation level.}}{58}{figure.caption.66}\protected@file@percent }
\newlabel{fig:r2-tradeoff}{{5.7}{58}{The gate threshold $R$ is a clean operating-point dial: low $R$ is selective (near-baseline success, small \ssm {} gain), high $R$ approaches unconditional scaling. The dominance claim is task-scoped, per the R0 protocol: on \emph {dishwasher} the gated frontier matches unconditional scaling's \ssm {}-violation at strictly higher success; on \emph {drawers} the gated frontier never reaches unconditional's absolute floor ($0.059$ vs.\ best gated $0.078$) but pays far less success at every \emph {shared} \ssm {}-violation level}{figure.caption.66}{}}
\newlabel{fig:r2-tradeoff@cref}{{[figure][7][5]5.7}{[1][57][]58}}
